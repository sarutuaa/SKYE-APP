{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Homework, exam, or activity task for students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childId": { "type": "string" },
        "type": { "type": "string", "enum": ["homework", "exam", "activity"] },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["not_started", "prepared", "done"] },
        "createdAt": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "type", "title", "date", "status"]
    }
  },
  "firestore": {
    "tasks/{taskId}": {
      "entity": "Task",
      "security": {
        "read": "true",
        "write": "true"
      }
    }
  }
}
